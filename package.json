{
  "name": "assay-ops",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run typecheck lint test",
    "setup": "bun install && uv sync"
  },
  "devDependencies": {
    "@assayops/biome-config": "workspace:*",
    "@biomejs/biome": "2.4.14",
    "quicktype": "23.2.6",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "ts/apps/*",
    "ts/packages/*",
    "py/packages/*"
  ]
}
